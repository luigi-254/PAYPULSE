rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Definitions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        getUserData(request.auth.uid).role == 'admin' ||
        request.auth.token.email == 'jkemboi744@gmail.com'
      );
    }
    
    function isStaff() {
      return isSignedIn() && (getUserData(request.auth.uid).role == 'staff' || isAdmin());
    }

    // 2. Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'name', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'staff'] &&
             data.name is string && data.name.size() <= 128 &&
             data.createdAt == request.time;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'phoneNumber', 'status', 'createdAt', 'createdBy']) &&
             data.amount is number && data.amount > 0 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 20 &&
             data.status == 'pending' &&
             data.createdAt == request.time &&
             data.createdBy == request.auth.uid &&
             (!data.keys().hasAny(['checkoutRequestId', 'merchantRequestId', 'mpesaReceiptNumber', 'customerMessage']));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'action', 'details', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.userId == request.auth.uid &&
             data.action is string && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 1000 &&
             data.createdAt == request.time;
    }

    // 3. Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow update: if isAdmin() && isValidUser(incoming()) && 
                    incoming().email == existing().email; // Email immutable
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (existing().createdBy == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      
      allow create: if isStaff() && isValidTransaction(incoming());
      
      // Updates are mostly handled by backend (admin SDK), but let's allow admins some corrections
      allow update: if isAdmin() && (
        // Action: Generic correction (restrict what can be corrected)
        incoming().diff(existing()).affectedKeys().hasAll(['status', 'description']) &&
        incoming().createdBy == existing().createdBy &&
        incoming().amount == existing().amount
      );
      
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
    }
  }
}
